# Mobile/web client configuration. Values prefixed EXPO_PUBLIC_ are embedded in the client.
EXPO_PUBLIC_SERVER_URL=http://localhost:3001
# Optional. Leave blank to hide the in-app contact form.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Socket server configuration (set these in server/.env or your hosting provider).
NODE_ENV=development
SERVER_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
