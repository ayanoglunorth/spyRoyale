{
  "name": "spyroyale",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo export --platform web && node ./scripts/fix-web-paths.js",
    "deploy": "npm run build:web && firebase deploy",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:server": "npm --prefix server test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run web\""
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.6.15",
    "base-64": "^1.0.0",
    "expo": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/base-64": "^1.0.2",
    "@types/react": "~19.2.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
